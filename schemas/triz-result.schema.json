{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIZ analysis result",
  "type": "object",
  "required": [
    "problem",
    "assumptions",
    "system_boundary",
    "main_function",
    "key_problem",
    "contradictions",
    "ifr",
    "resources",
    "concepts",
    "recommendation",
    "metrics",
    "evidence",
    "uncertainties"
  ],
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "system_boundary": {
      "type": "string"
    },
    "main_function": {
      "type": "string"
    },
    "key_problem": {
      "type": "string"
    },
    "contradictions": {
      "type": "object",
      "required": [
        "administrative",
        "technical",
        "physical"
      ],
      "properties": {
        "administrative": {
          "type": "string"
        },
        "technical": {
          "type": "string"
        },
        "physical": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ifr": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "triz_tool",
          "mechanism",
          "assumptions",
          "risks",
          "test"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "triz_tool": {
            "type": "string"
          },
          "mechanism": {
            "type": "string"
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test": {
            "type": "string"
          }
        }
      }
    },
    "recommendation": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "status",
          "source"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "assumption",
              "hypothesis",
              "example"
            ]
          },
          "source": {
            "type": "string"
          }
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
