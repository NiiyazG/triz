{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TRIZ analysis result",
  "type": "object",
  "required": [
    "problem",
    "assumptions",
    "system_boundary",
    "main_function",
    "key_problem",
    "contradictions",
    "ifr",
    "resources",
    "concepts",
    "recommendation",
    "metrics",
    "evidence",
    "uncertainties"
  ],
  "properties": {
    "problem": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "description": "Cynefin domain of the problem situation",
      "enum": ["clear", "complicated", "complex", "chaotic"]
    },
    "problem_nature": {
      "description": "Diagnosed nature of the problem",
      "enum": [
        "technical_contradiction",
        "physical_contradiction",
        "dilemma",
        "network_of_problems",
        "uncertainty",
        "infeasibility",
        "multiobjective",
        "none"
      ]
    },
    "exit": {
      "description": "Honest router exit when no inventive solution is appropriate",
      "enum": ["optimization", "measure_first", "insufficient_data", "no_solution"]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "system_boundary": {
      "type": "string"
    },
    "main_function": {
      "type": "string"
    },
    "key_problem": {
      "type": "string"
    },
    "contradictions": {
      "type": "object",
      "required": ["administrative"],
      "properties": {
        "administrative": {
          "type": "string"
        },
        "technical": {
          "type": "string"
        },
        "physical": {
          "type": "string"
        },
        "dilemma": {
          "description": "TOC Evaporating Cloud conflict when the conflict is a value/policy dilemma",
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["technical"] },
        { "required": ["physical"] },
        { "required": ["dilemma"] }
      ]
    },
    "ifr": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "mechanism",
          "assumptions",
          "risks",
          "test"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "triz_tool": {
            "description": "Optional; omit or set not_applicable when no single tool applies",
            "type": "string"
          },
          "mechanism": {
            "type": "string",
            "minLength": 8
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "recommendation": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "status",
          "source"
        ],
        "properties": {
          "claim": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "assumption",
              "hypothesis",
              "example"
            ]
          },
          "source": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
