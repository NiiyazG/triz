{"id": "B01", "prompt": "Ускорить API без потери консистентности", "must_include": ["техническое противоречие", "ИКР", "метрик"], "must_not_claim": ["это АРИЗ"]}
{"id": "B02", "prompt": "Материал должен быть твёрдым и мягким", "must_include": ["услов", "разделен"], "must_not_claim": ["физическое противоречие решено само по себе"]}
{"id": "B03", "prompt": "Проведи вепольный анализ вредного взаимодействия", "must_include": ["S1", "S2", "поле", "вред"], "must_not_claim": ["S1 + S2 -> F"]}
{"id": "B04", "prompt": "Примени АРИЗ к простой задаче выбора кнопки", "must_include": ["АРИЗ не требуется"], "must_not_claim": ["пятишаговый АРИЗ"]}
{"id": "B05", "prompt": "Предложи решение, но данных мало", "must_include": ["допущен", "неопредел"], "must_not_claim": ["точно", "гарантированно"]}
{"id": "B06", "prompt": "Отдел продаж требует большие партии, производство — малые, компромисс неприемлем", "must_include": ["допущени", "потребност", "цель"], "must_not_claim": ["техническое противоречие"]}
{"id": "B07", "prompt": "Примени ТРИЗ к нестабильному рынку с непредсказуемыми потребителями", "must_include": ["домен", "probe", "сначала"], "must_not_claim": ["корневое противоречие"]}
{"id": "B08", "prompt": "Несколько взаимосвязанных дефектов в сложной системе, нужна большая картина", "must_include": ["сеть", "bottleneck", "противоречи"], "must_not_claim": ["единственная причина"]}
{"id": "B09", "prompt": "Как ускорить сборку, если есть готовый проверенный способ?", "must_include": ["оптимизац", "стандарт"], "must_not_claim": ["ИКР", "противоречие"]}
{"id": "B10", "prompt": "Выбери лучшую из трёх концепций по нескольким критериям", "must_include": ["критер", "обязательн", "операциональн"], "must_not_claim": ["единственно верный"]}
{"id": "B11", "prompt": "Нужно систематически перебрать варианты конструкции из нескольких параметров", "must_include": ["параметр", "совместимост", "конфигурац"], "must_not_claim": ["попарная совместимость достаточна"]}
{"id": "B12", "prompt": "Один параметр улучшения портит другой, требования связаны", "must_include": ["связан", "независимост", "противореч"], "must_not_claim": ["аксиомы доказывают решение"]}
